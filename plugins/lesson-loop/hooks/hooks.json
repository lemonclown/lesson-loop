{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/extract-skill.sh",
            "timeout": 30,
            "statusMessage": "lesson-loop: checking session for reusable skills"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/extract-skill.sh",
            "timeout": 30,
            "statusMessage": "lesson-loop: extracting skills before compaction"
          }
        ]
      }
    ]
  }
}
